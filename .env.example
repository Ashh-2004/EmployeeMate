# LLM Provider Configuration ("none", "gemini", "openai", "lmstudio", or "local")
LLM_PROVIDER=none

# Google Gemini Settings
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI Settings (Optional Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LM Studio / Local LLM Settings ("lmstudio" or "local")
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma
LLM_TIMEOUT=3.0

# App Settings
APP_ENV=development
LOG_LEVEL=INFO

# Authentication & Security Settings
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DEMO_EMPLOYEE_PASSWORD=emp123
DEMO_HR_PASSWORD=hr123

# RAG & Vector Database Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_VECTOR_DISTANCE=1.35
MIN_RERANK_SCORE=0.0
